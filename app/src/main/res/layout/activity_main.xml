<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ── Top App Bar ────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Scrollable Content ─────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── 1. URL Input Card ─────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_url"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/urlInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_url"
                        app:endIconMode="clear_text"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/urlEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Paste button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaste"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_paste"
                        app:icon="@android:drawable/ic_menu_edit" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── 2. Download Mode Card ──────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_mode"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <RadioGroup
                        android:id="@+id/radioGroupMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioVideo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/mode_video" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioVideoPlaylist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_video_playlist" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioMusicPlaylist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_music_playlist" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioOneMusic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_one_music" />

                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── 3. Quality / Format Card (dynamic) ────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/labelFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_resolution"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <!-- Video Resolution options (visible when Video mode selected) -->
                    <RadioGroup
                        android:id="@+id/radioGroupVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioV720"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/res_720p" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioV1080"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/res_1080p" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioV1440"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/res_1440p" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioV2160"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/res_2160p" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioVBest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/res_best" />

                    </RadioGroup>

                    <!-- Audio Format options (visible when Music mode selected) -->
                    <RadioGroup
                        android:id="@+id/radioGroupAudio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioAM4a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/audio_m4a" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioAMp3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/audio_mp3" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioAWebm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/audio_webm" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioAOpus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/audio_opus" />

                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── 4. Embed Options Card (optional flag chips) ─────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmbed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_embed"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEmbed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipChapters"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/embed_chapters" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipThumbnail"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/embed_thumbnail" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSubs"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="true"
                            android:text="@string/embed_subs" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMetadata"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/embed_metadata" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── 5. Download Button ─────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_download"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/stat_sys_download" />

            <!-- ── 6. Progress + Log Card ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status label + ETA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/status_downloading"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />

                        <TextView
                            android:id="@+id/tvEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />

                    </LinearLayout>

                    <!-- Progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:trackCornerRadius="4dp" />

                    <!-- Stop Download Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopDownload"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Stop Download"
                        android:textColor="?attr/colorError"
                        app:icon="@android:drawable/ic_delete"
                        app:iconTint="?attr/colorError" />

                    <!-- Scrollable log output with independent scrolling capabilities -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="0dp">

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/logScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:scrollbarStyle="insideOverlay"
                            android:scrollbars="vertical">

                            <TextView
                                android:id="@+id/tvLog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:padding="8dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textIsSelectable="true" />

                        </androidx.core.widget.NestedScrollView>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>